# =============================================================================
# Variaveis de build do container TECSOFT Landing
# =============================================================================
# Como usar:
#   1. Copie este arquivo para .env na raiz do projeto:
#        cp .env.docker.example .env
#   2. Preencha os valores reais abaixo.
#   3. Rode:
#        docker compose build
#        docker compose up -d
#
# Importante:
#   - Estas variaveis sao consumidas como BUILD ARGS pelo docker-compose.yml e
#     embutidas no bundle JavaScript final pelo react-scripts (padrao do CRA).
#   - As chaves Firebase Web sao publicas por design (ficam no client mesmo
#     quando hospedado no Firebase). A protecao real esta nas Security Rules
#     do Firestore/Storage, que ja existem no repositorio.
#   - Apos alterar qualquer valor aqui, rebuilde a imagem:
#        docker compose build --no-cache
# =============================================================================

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

REACT_APP_ENVIRONMENT=production
